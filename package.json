{
  "name": "leaf-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/vendor.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "fixtures": "node tests/fixtures/generate.mjs",
    "check": "npm run fixtures && npm test && npm run build && npm run test:e2e",
    "mobile:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@zip.js/zip.js": "2.25.0",
    "pdfjs-dist": "6.5.438",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "1.65.1",
    "vite": "8.3.8"
  }
}
